OMNICOURSE_DATA_DIR=backend/app/data
OMNICOURSE_STATIC_DIR=backend/app/static
OMNICOURSE_DEMO_MODE=true

# Local ASR / speech-to-text. The default runner uses faster-whisper in omniC.
OMNICOURSE_ENABLE_ASR=1
OMNICOURSE_ASR_PROVIDER=faster_whisper
OMNICOURSE_ASR_MODEL=small.en
OMNICOURSE_ASR_DEVICE=auto
OMNICOURSE_ASR_COMPUTE_TYPE=float16
OMNICOURSE_ASR_LANGUAGE=en
OMNICOURSE_ASR_WORD_TIMESTAMPS=1
OMNICOURSE_ASR_VAD_FILTER=1
OMNICOURSE_ASR_REUSE_CACHE=1
OMNICOURSE_ASR_MODEL_DIR=../checkpoints/asr
OMNICOURSE_ASR_PYTHON=/home/haoqian/miniconda3/envs/omniC/bin/python

# Real text embeddings for search fusion.
OMNICOURSE_TEXT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
OMNICOURSE_EMBED_MODEL_DIR=../checkpoints/embeddings
OMNICOURSE_EMBED_PYTHON=/home/haoqian/miniconda3/envs/omniC/bin/python
OMNICOURSE_IMAGE_EMBED_MODEL=ViT-B-32
OMNICOURSE_IMAGE_EMBED_PRETRAINED=laion2b_s34b_b79k
OMNICOURSE_IMAGE_EMBED_DEVICE=auto

# Azure OpenAI / GPT-4o. Do not commit real values.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional OCR providers.
DEEPSEEK_OCR_ENDPOINT=
DEEPSEEK_OCR_API_KEY=
DEEPSEEK_OCR_MODEL=
DEEPSEEK_OCR_MODEL_PATH=../checkpoints/DeepSeek-OCR
DEEPSEEK_OCR_ATTN=eager

# InternVideo3 integration. Prefer the persistent local server for demos:
#   scripts/run_internvideo3_server.sh
INTERNVIDEO3_ENDPOINT=http://127.0.0.1:8011/score
INTERNVIDEO3_CLI=
INTERNVIDEO3_MODEL_PATH=../checkpoints/InternVideo3-8B-Instruct
INTERNVIDEO3_ENABLE_LOCAL=1
INTERNVIDEO3_LOCAL_RERANK=1
INTERNVIDEO3_LOCAL_RERANK_TOP_N=1
INTERNVIDEO3_LOCAL_FPS=0.25
INTERNVIDEO3_LOCAL_MAX_FRAMES=8
INTERNVIDEO3_LOCAL_MAX_NEW_TOKENS=96
INTERNVIDEO3_LOCAL_TIMEOUT=420
INTERNVIDEO3_PYTHON=/home/haoqian/miniconda3/envs/omniC/bin/python
