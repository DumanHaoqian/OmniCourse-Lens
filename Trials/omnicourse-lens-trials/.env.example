OMNICOURSE_DATA_DIR=backend/app/data
OMNICOURSE_STATIC_DIR=backend/app/static
OMNICOURSE_DEMO_MODE=true

# Azure OpenAI / GPT-4o. Do not commit real values.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional OCR providers.
DEEPSEEK_OCR_ENDPOINT=
DEEPSEEK_OCR_API_KEY=
DEEPSEEK_OCR_MODEL=
DEEPSEEK_OCR_MODEL_PATH=../checkpoints/DeepSeek-OCR
DEEPSEEK_OCR_ATTN=eager

# Optional InternVideo3 integration.
INTERNVIDEO3_ENDPOINT=
INTERNVIDEO3_CLI=
INTERNVIDEO3_MODEL_PATH=../checkpoints/InternVideo3-8B-Instruct
INTERNVIDEO3_ENABLE_LOCAL=1
INTERNVIDEO3_LOCAL_RERANK=1
INTERNVIDEO3_LOCAL_RERANK_TOP_N=1
INTERNVIDEO3_LOCAL_FPS=0.25
INTERNVIDEO3_LOCAL_MAX_FRAMES=8
INTERNVIDEO3_LOCAL_MAX_NEW_TOKENS=96
INTERNVIDEO3_LOCAL_TIMEOUT=420
INTERNVIDEO3_PYTHON=/home/haoqian/miniconda3/envs/omniC/bin/python
